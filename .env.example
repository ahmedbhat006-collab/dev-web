# --- Required ---
# Neon: use the direct (non-pooled) connection string
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Long random strings (any 32+ chars)
JWT_SECRET="change-me-to-a-long-random-string"
# 32 random bytes, base64. If empty, derived from JWT_SECRET.
ENCRYPTION_KEY=""
# Public URL of the app (ngrok / deployed URL). Used for webhooks, OAuth redirect and email links.
APP_URL="http://localhost:3000"

# --- Google Calendar (app-level OAuth client; each employee connects their own account) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Optional: pre-fill the seeded demo workspace's integrations (each workspace can also connect its own in Settings > Integrations) ---
# Meta WhatsApp Cloud API (free test number): developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""        # App settings > Basic > App secret (used to verify webhook signatures)
WHATSAPP_VERIFY_TOKEN=""      # any string you choose; paste the same value in the Meta webhook config
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RESEND_API_KEY=""
RESEND_FROM="Dastak <onboarding@resend.dev>"

# --- AI chat assistant (Google Gemini, free tier). Create a key at aistudio.google.com > Get API key ---
GEMINI_API_KEY=""
